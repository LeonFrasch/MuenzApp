<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".StartingPageActivity"
    android:background="@drawable/block_background_landscape">
    <Button
        android:layout_width="96dp"
        android:layout_height="96dp" android:background="@drawable/block_small_icon"
        android:scaleType="centerCrop"
        android:id="@+id/YearONE"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="48dp"
        android:visibility="visible" android:layout_marginStart="72dp"/>
    <Button
        android:layout_width="96dp"
        android:layout_height="96dp" android:background="@drawable/block_small_icon"
        android:id="@+id/YearTWO"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="166dp" android:layout_marginStart="239dp"
        android:visibility="visible" app:layout_constraintStart_toStartOf="parent"/>
    <Button
        android:layout_width="96dp"
        android:layout_height="96dp" android:background="@drawable/block_small_icon"
        android:id="@+id/YearTHREE"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="358dp" android:layout_marginTop="47dp"
        android:visibility="visible" app:layout_constraintStart_toStartOf="parent"/>
    <Button
        android:layout_width="96dp"
        android:layout_height="96dp" android:background="@drawable/block_small_icon"
        android:id="@+id/YearFOUR"
        android:visibility="visible"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="860dp" app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="118dp"/>
    <Button
        android:layout_width="96dp"
        android:layout_height="96dp" android:background="@drawable/block_small_icon"
        android:id="@+id/YearFIVE"
        android:visibility="visible"
        app:layout_constraintStart_toStartOf="parent" android:layout_marginStart="24dp"
        app:layout_constraintTop_toTopOf="parent" android:layout_marginTop="237dp"/>
    <Button
        android:layout_width="96dp"
        android:layout_height="96dp" android:background="@drawable/block_small_icon"
        android:id="@+id/YearSIX"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" android:layout_marginTop="309dp"
        android:visibility="visible" android:layout_marginStart="215dp"/>
    <Button
        android:layout_width="96dp"
        android:layout_height="96dp" android:background="@drawable/block_small_icon"
        android:id="@+id/YearSEVEN"
        android:visibility="visible" app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="71dp" app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="549dp"/>
    <Button
        android:layout_width="96dp"
        android:layout_height="96dp" android:background="@drawable/block_small_icon"
        android:id="@+id/YearEIGHT"
        android:visibility="visible"
        app:layout_constraintStart_toStartOf="parent" android:layout_marginStart="645dp"
        app:layout_constraintTop_toTopOf="parent" android:layout_marginTop="262dp"/>
    <Button
        android:layout_width="96dp"
        android:layout_height="96dp" android:background="@drawable/block_small_icon"
        android:id="@+id/YearNINE"
        android:visibility="visible" app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="332dp" app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="844dp"/>
    <Button
        android:layout_width="96dp"
        android:layout_height="96dp" android:background="@drawable/block_small_icon"
        android:id="@+id/YearTEN"
        android:visibility="visible" app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="332dp" app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="468dp"/>
    <Button
        android:layout_width="96dp"
        android:layout_height="96dp" android:background="@drawable/block_small_icon"
        android:id="@+id/YearELEVEN"
        android:visibility="visible" app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="44dp" app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="712dp"/>
    <Button
        android:layout_width="96dp"
        android:layout_height="96dp" android:background="@drawable/block_small_icon"
        android:id="@+id/YearTWELVE"
        android:visibility="visible" app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="192dp" app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="420dp"/>
    <TextView
        android:text="A"
        android:layout_width="24dp"
        android:layout_height="24dp" android:id="@+id/yearONEText"
        android:background="@color/yellow"
        android:textColor="@color/black" android:gravity="center"
        app:layout_constraintStart_toStartOf="@+id/YearONE" app:layout_constraintTop_toTopOf="@+id/YearONE"
        android:visibility="visible"
        />
    <TextView
        android:text="F"
        android:layout_width="24dp"
        android:layout_height="24dp" android:id="@+id/yearTWOText" android:textColor="@color/black" android:gravity="center"
        android:background="@color/yellow"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="@+id/YearTWO" app:layout_constraintStart_toStartOf="@+id/YearTWO"/>
    <TextView
        android:text="NL"
        android:layout_width="24dp"
        android:layout_height="24dp" android:id="@+id/yearTHREEText" android:textColor="@color/black" android:gravity="center"
        android:background="@color/yellow"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="@+id/YearTHREE" app:layout_constraintStart_toStartOf="@+id/YearTHREE"/>
    <TextView
        android:text="GR"
        android:layout_width="24dp"
        android:layout_height="24dp" android:id="@+id/yearFOURText" android:textColor="@color/black" android:gravity="center"
        android:background="@color/yellow"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="@+id/YearFOUR" app:layout_constraintStart_toStartOf="@+id/YearFOUR"/>
    <TextView
        android:text="D"
        android:layout_width="24dp"
        android:layout_height="24dp" android:id="@+id/yearFIVEText" android:textColor="@color/black" android:gravity="center"
        android:background="@color/yellow"
        android:visibility="visible"
        app:layout_constraintStart_toStartOf="@+id/YearFIVE" app:layout_constraintTop_toTopOf="@+id/YearFIVE"/>
    <TextView
        android:text="L"
        android:layout_width="24dp"
        android:layout_height="24dp" android:id="@+id/yearSIXText" android:textColor="@color/black" android:gravity="center"
        android:background="@color/yellow"
        android:visibility="visible"
        app:layout_constraintStart_toStartOf="@+id/YearSIX" app:layout_constraintTop_toTopOf="@+id/YearSIX"/>
    <TextView
        android:text="E"
        android:layout_width="24dp"
        android:layout_height="24dp" android:id="@+id/yearSEVENText" android:textColor="@color/black" android:gravity="center"
        android:background="@color/yellow"
        android:visibility="visible"
        app:layout_constraintStart_toStartOf="@+id/YearSEVEN" app:layout_constraintTop_toTopOf="@+id/YearSEVEN"/>
    <TextView
        android:text="I"
        android:layout_width="24dp"
        android:layout_height="24dp" android:id="@+id/yearEIGHTText"
        android:background="@color/yellow"
        android:textColor="@color/black" android:gravity="center"
        app:layout_constraintStart_toStartOf="@+id/YearEIGHT" app:layout_constraintTop_toTopOf="@+id/YearEIGHT"
        android:visibility="visible"
        />
    <TextView
        android:text="IR"
        android:layout_width="24dp"
        android:layout_height="24dp" android:id="@+id/yearNINEText" android:textColor="@color/black" android:gravity="center"
        android:background="@color/yellow"
        android:visibility="visible"
        app:layout_constraintStart_toStartOf="@+id/YearNINE" app:layout_constraintTop_toTopOf="@+id/YearNINE"/>
    <TextView
        android:text="B"
        android:layout_width="24dp"
        android:layout_height="24dp" android:id="@+id/yearTENText" android:textColor="@color/black" android:gravity="center"
        android:background="@color/yellow"
        android:visibility="visible"
        app:layout_constraintStart_toStartOf="@+id/YearTEN" app:layout_constraintTop_toTopOf="@+id/YearTEN"/>
    <TextView
        android:text="FIN"
        android:layout_width="24dp"
        android:layout_height="24dp" android:id="@+id/yearELEVENText" android:textColor="@color/black" android:gravity="center"
        android:background="@color/yellow"
        android:visibility="visible"
        app:layout_constraintStart_toStartOf="@+id/YearELEVEN" app:layout_constraintTop_toTopOf="@+id/YearELEVEN"/>
    <TextView
        android:text="P"
        android:layout_width="24dp"
        android:layout_height="24dp" android:id="@+id/yearTWELVEText" android:textColor="@color/black" android:gravity="center"
        android:background="@color/yellow"
        android:visibility="visible"
        app:layout_constraintStart_toStartOf="@+id/YearTWELVE" app:layout_constraintTop_toTopOf="@+id/YearTWELVE"/>
</androidx.constraintlayout.widget.ConstraintLayout>