<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".InternCoins.InternAddingActivity"
    android:background="@color/white">
    <TextView
        android:text="TextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:id="@+id/Country"
        android:textColor="@color/black"
        android:textSize="40sp"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="44dp" android:layout_marginStart="36dp"/>

    <Button
        android:id="@+id/addToDatabase"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="180dp"
        android:backgroundTint="@color/button_color"
        android:text="Hinzufügen"
        android:textColor="@color/black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/moneyText" />

    <TextView
        android:text="Jahr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:id="@+id/yearText"
        android:textColor="@color/black"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="56dp"
        app:layout_constraintBottom_toTopOf="@+id/moneyText" android:layout_marginBottom="48dp"/>

    <TextView
        android:id="@+id/moneyText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="180dp"
        android:text="Cent / Euro"
        android:textColor="@color/black"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <EditText
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:inputType="number"
        android:ems="3"
        android:id="@+id/addYearEditText"
        android:textColor="@color/black" android:backgroundTint="@color/black"
        app:layout_constraintStart_toEndOf="@+id/yearText" android:layout_marginStart="28dp"
        app:layout_constraintTop_toTopOf="parent" android:layout_marginTop="104dp"/>

    <ImageButton
        android:id="@+id/addButtonTWO"
        android:layout_width="@dimen/text_width"
        android:layout_height="@dimen/text_height"
        android:layout_marginStart="24dp"
        android:layout_marginTop="220dp"
        android:background="#00000000"
        app:layout_constraintStart_toEndOf="@+id/addButtonONE"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@mipmap/coin_two_foreground" />

    <ImageButton
        android:id="@+id/addButtonTWENTY"
        android:layout_width="@dimen/text_width"
        android:layout_height="@dimen/text_height"
        android:layout_marginStart="24dp"
        android:layout_marginTop="220dp"
        android:background="#00000000"
        app:layout_constraintStart_toEndOf="@+id/addButtonTEN"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@mipmap/coin_twenty_foreground" />

    <ImageButton
        android:id="@+id/addButtonONE"
        android:layout_width="@dimen/text_width"
        android:layout_height="@dimen/text_height"
        android:layout_marginStart="24dp"
        android:layout_marginTop="220dp"
        android:background="#00000000"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@mipmap/coin_one_foreground" />

    <ImageButton
        android:id="@+id/addButtonTEN"
        android:layout_width="@dimen/text_width"
        android:layout_height="@dimen/text_height"
        android:layout_marginStart="24dp"
        android:layout_marginTop="220dp"
        android:background="#00000000"
        app:layout_constraintStart_toEndOf="@+id/addButtonFIVE"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@mipmap/coin_ten_foreground" />

    <ImageButton
        android:id="@+id/addButtonII"
        android:layout_width="@dimen/text_width"
        android:layout_height="@dimen/text_height"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:background="#00000000"
        app:layout_constraintStart_toEndOf="@+id/addButtonI"
        app:layout_constraintTop_toBottomOf="@+id/addButtonTWO"
        app:srcCompat="@mipmap/coin_ii_foreground" />

    <ImageButton
        android:id="@+id/addButtonFIFTY"
        android:layout_width="@dimen/text_width"
        android:layout_height="@dimen/text_height"
        android:layout_marginStart="24dp"
        android:layout_marginTop="220dp"
        android:background="#00000000"
        app:layout_constraintStart_toEndOf="@+id/addButtonTWENTY"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@mipmap/coin_fifty_foreground" />

    <ImageButton
        android:id="@+id/addButtonI"
        android:layout_width="@dimen/text_width"
        android:layout_height="@dimen/text_height"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:background="#00000000"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/addButtonONE"
        app:srcCompat="@mipmap/coin_i_foreground" />

    <ImageButton
        android:id="@+id/addButtonFIVE"
        android:layout_width="@dimen/text_width"
        android:layout_height="@dimen/text_height"
        android:layout_marginStart="24dp"
        android:layout_marginTop="220dp"
        android:background="#00000000"
        app:layout_constraintStart_toEndOf="@+id/addButtonTWO"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@mipmap/coin_five_foreground" />

    <ImageButton
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" app:srcCompat="@android:drawable/btn_dialog"
        android:background="#00000000"
        android:id="@+id/closeCoinYearAdding"
        app:layout_constraintTop_toTopOf="parent" android:layout_marginTop="24dp" android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"/>


</androidx.constraintlayout.widget.ConstraintLayout>