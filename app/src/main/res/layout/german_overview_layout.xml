<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activities.GermanCoins.GermanOverviewActivity"
    android:background="@color/white">

    <ImageButton
        android:id="@+id/closeCoinYearAdding2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#00000000"
        app:srcCompat="@android:drawable/btn_dialog"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="25dp"
        android:layout_marginEnd="25dp"/>
    <Button
        android:id="@+id/addCoinYear"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/button_color"
        android:text="Münzen hinzufügen."
        android:textAllCaps="false"
        android:textColor="@color/black"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="25dp"/>
    <Button
        android:id="@+id/openSonderII"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/button_color"
        android:text="Sonder II."
        android:textAllCaps="false"
        android:textColor="@color/black"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="25dp"
        android:layout_marginStart="10dp"/>

    <Button
        android:id="@+id/YearOne"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:background="@drawable/block_small_icon"
        android:scaleType="centerCrop"
        android:visibility="invisible"
        android:layout_marginStart="60dp"
        android:layout_marginTop="30dp"/>

    <Button
        android:id="@+id/YearTwo"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:background="@drawable/block_small_icon"
        android:visibility="invisible"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="100dp"
        android:layout_marginEnd="100dp"
        />

    <Button
        android:id="@+id/YearThree"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:background="@drawable/block_small_icon"
        android:visibility="invisible"
        android:layout_below="@id/YearTwo"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="70dp"

        />

    <Button
        android:id="@+id/YearFour"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:background="@drawable/block_small_icon"
        android:visibility="invisible"
        android:layout_below="@id/YearOne"
        android:layout_marginTop="50dp"
        android:layout_marginStart="10dp"/>

    <Button
        android:id="@+id/YearFive"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:background="@drawable/block_small_icon"
        android:visibility="invisible"
        android:layout_below="@id/YearFour"
        android:layout_marginTop="60dp"
        android:layout_marginStart="100dp"
         />

    <Button
        android:id="@+id/YearSix"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:background="@drawable/block_small_icon"
        android:visibility="invisible"
        android:layout_below="@id/YearThree"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="80dp"
        android:layout_alignParentEnd="true"
         />

    <Button
        android:id="@+id/YearEight"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="10dp"
        android:layout_marginBottom="164dp"
        android:background="@drawable/block_small_icon"
        android:visibility="invisible" />

    <Button
        android:id="@+id/YearSeven"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:background="@drawable/block_small_icon"
        android:visibility="invisible"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginBottom="100dp"
        android:layout_marginEnd="30dp"/>

    <TextView
        android:text="@+text/TextONE"
        android:layout_width="24dp"
        android:layout_height="24dp" android:id="@+id/yearONEText"
        android:background="@color/yellow"
        android:textColor="@color/black" android:gravity="center"
        android:visibility="invisible"
        android:layout_alignTop="@id/YearOne"
        android:layout_alignStart="@id/YearOne"
        />
    <TextView
        android:text="@+text/TextEIGHT"
        android:layout_width="24dp"
        android:layout_height="24dp" android:id="@+id/yearEIGHTText"
        android:background="@color/yellow"
        android:textColor="@color/black" android:gravity="center"
        android:visibility="invisible"
        android:layout_alignTop="@id/YearEight"
        android:layout_alignStart="@id/YearEight"
        />
    <TextView
        android:text="@+text/TextTWO"
        android:layout_width="24dp"
        android:layout_height="24dp" android:id="@+id/yearTWOText" android:textColor="@color/black" android:gravity="center"
        android:background="@color/yellow"
        android:visibility="invisible"
        android:layout_alignTop="@id/YearTwo"
        android:layout_alignStart="@id/YearTwo"
        />
    <TextView
        android:text="@+text/TextTHREE"
        android:layout_width="24dp"
        android:layout_height="24dp" android:id="@+id/yearTHREEText" android:textColor="@color/black" android:gravity="center"
        android:background="@color/yellow"
        android:visibility="invisible"
        android:layout_alignTop="@id/YearThree"
        android:layout_alignStart="@id/YearThree"
        />
    <TextView
        android:text="@+text/TextFOUR"
        android:layout_width="24dp"
        android:layout_height="24dp" android:id="@+id/yearFOURText" android:textColor="@color/black" android:gravity="center"
        android:background="@color/yellow"
        android:visibility="invisible"
        android:layout_alignTop="@id/YearFour"
        android:layout_alignStart="@id/YearFour"
        />
    <TextView
        android:text="@+text/TextFIVE"
        android:layout_width="24dp"
        android:layout_height="24dp" android:id="@+id/yearFIVEText" android:textColor="@color/black" android:gravity="center"
        android:background="@color/yellow"
        android:visibility="invisible"
        android:layout_alignTop="@id/YearFive"
        android:layout_alignStart="@id/YearFive"
        />
    <TextView
        android:text="@+text/TextSIX"
        android:layout_width="24dp"
        android:layout_height="24dp" android:id="@+id/yearSIXText" android:textColor="@color/black" android:gravity="center"
        android:background="@color/yellow"
        android:visibility="invisible"
        android:layout_alignTop="@id/YearSix"
        android:layout_alignStart="@id/YearSix"
        />
    <TextView
        android:text="@+text/TextSEVEN"
        android:layout_width="24dp"
        android:layout_height="24dp" android:id="@+id/yearSEVENText" android:textColor="@color/black" android:gravity="center"
        android:background="@color/yellow"
        android:visibility="invisible"
        android:layout_alignTop="@id/YearSeven"
        android:layout_alignStart="@id/YearSeven"
        />
</RelativeLayout>