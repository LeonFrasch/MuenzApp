<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".GermanCoins.GermanAddingActivity"
    android:background="@drawable/block_background">

    <Button
        android:text="Hinzufügen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:id="@+id/addToDatabase"
        android:backgroundTint="@color/button_color"
        android:textColor="@color/black"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="36dp" app:layout_constraintTop_toBottomOf="@+id/moneyText"
        android:layout_marginTop="56dp"/>
    <TextView
        android:text="Jahr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:id="@+id/yearText"
        android:textColor="@color/black"
        android:textSize="20sp" app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" android:layout_marginTop="56dp"
        android:layout_marginStart="60dp"/>
    <TextView
        android:text="Buchstaben"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:id="@+id/letterText" android:textColor="@color/black"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@+id/yearText"
        android:layout_marginTop="32dp" android:layout_marginStart="16dp" android:textSize="20sp"/>
    <TextView
        android:text="Cent Euro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:id="@+id/moneyText" android:textColor="@color/black"
        app:layout_constraintTop_toBottomOf="@+id/letterText" app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="48dp" android:layout_marginStart="36dp" android:textSize="20sp"/>
    <EditText
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:inputType="number"
        android:ems="3"
        android:id="@+id/addYearEditText"
        android:textColor="@color/black" android:backgroundTint="@color/black"
        app:layout_constraintStart_toEndOf="@+id/yearText" android:layout_marginStart="44dp"
        app:layout_constraintTop_toTopOf="parent" android:layout_marginTop="40dp"/>
    <ImageButton
        android:layout_width="@dimen/text_width"
        android:layout_height="@dimen/text_height" app:srcCompat="@drawable/letter_a_foreground"
        android:background="#00000000"
        android:id="@+id/addButtonA"
        app:layout_constraintStart_toEndOf="@+id/letterText" android:layout_marginStart="20dp"
        app:layout_constraintTop_toTopOf="parent" android:layout_marginTop="100dp"/>
    <ImageButton
        android:layout_width="@dimen/text_width"
        android:layout_height="@dimen/text_height" app:srcCompat="@drawable/letter_d_foreground"
        android:background="#00000000"
        android:id="@+id/addButtonD"
        app:layout_constraintStart_toEndOf="@+id/addButtonA" android:layout_marginStart="24dp"
        app:layout_constraintTop_toTopOf="parent" android:layout_marginTop="100dp"/>
    <ImageButton
        android:layout_width="@dimen/text_width"
        android:layout_height="@dimen/text_height" app:srcCompat="@drawable/letter_f_foreground"
        android:background="#00000000"
        android:id="@+id/addButtonF"
        app:layout_constraintStart_toEndOf="@+id/addButtonD" android:layout_marginStart="24dp"
        app:layout_constraintTop_toTopOf="parent" android:layout_marginTop="100dp"/>
    <ImageButton
        android:layout_width="@dimen/text_width"
        android:layout_height="@dimen/text_height" app:srcCompat="@drawable/letter_g_foreground"
        android:background="#00000000"
        android:id="@+id/addButtonG"
        app:layout_constraintStart_toEndOf="@+id/addButtonF" android:layout_marginStart="24dp"
        app:layout_constraintTop_toTopOf="parent" android:layout_marginTop="100dp"/>
    <ImageButton
        android:layout_width="@dimen/text_width"
        android:layout_height="@dimen/text_height" app:srcCompat="@drawable/letter_j_foreground"
        android:background="#00000000"
        android:id="@+id/addButtonJ"
        app:layout_constraintStart_toEndOf="@+id/addButtonG" android:layout_marginStart="24dp"
        app:layout_constraintTop_toTopOf="parent" android:layout_marginTop="100dp"/>
    <ImageButton
        android:layout_width="@dimen/text_width"
        android:layout_height="@dimen/text_height" app:srcCompat="@mipmap/coin_one_foreground"
        android:background="#00000000"
        android:id="@+id/addButtonONE"
        app:layout_constraintStart_toEndOf="@+id/moneyText" android:layout_marginStart="20dp"
        app:layout_constraintTop_toBottomOf="@+id/addButtonA" android:layout_marginTop="24dp"
        />
    <ImageButton
        android:layout_width="@dimen/text_width"
        android:layout_height="@dimen/text_height" app:srcCompat="@mipmap/coin_two_foreground"
        android:background="#00000000"
        android:id="@+id/addButtonTWO"
        app:layout_constraintStart_toEndOf="@+id/addButtonONE"
        app:layout_constraintTop_toBottomOf="@+id/addButtonD" android:layout_marginTop="24dp"
        android:layout_marginStart="24dp"/>
    <ImageButton
        android:layout_width="@dimen/text_width"
        android:layout_height="@dimen/text_height" app:srcCompat="@mipmap/coin_five_foreground"
        android:background="#00000000"
        android:id="@+id/addButtonFIVE"
        app:layout_constraintStart_toEndOf="@+id/addButtonTWO"
        app:layout_constraintTop_toBottomOf="@+id/addButtonF" android:layout_marginTop="24dp"
        android:layout_marginStart="24dp"/>
    <ImageButton
        android:layout_width="@dimen/text_width"
        android:layout_height="@dimen/text_height" app:srcCompat="@mipmap/coin_ten_foreground"
        android:background="#00000000"
        android:id="@+id/addButtonTEN"
        app:layout_constraintTop_toBottomOf="@+id/addButtonG"
        app:layout_constraintStart_toEndOf="@+id/addButtonFIVE" android:layout_marginTop="24dp"
        android:layout_marginStart="24dp"/>
    <ImageButton
        android:layout_width="@dimen/text_width"
        android:layout_height="@dimen/text_height" app:srcCompat="@mipmap/coin_twenty_foreground"
        android:background="#00000000"
        android:id="@+id/addButtonTWENTY"
        app:layout_constraintTop_toBottomOf="@+id/addButtonJ"
        app:layout_constraintStart_toEndOf="@+id/addButtonTEN" android:layout_marginTop="24dp"
        android:layout_marginStart="24dp"/>
    <ImageButton
        android:layout_width="@dimen/text_width"
        android:layout_height="@dimen/text_height" app:srcCompat="@mipmap/coin_fifty_foreground"
        android:background="#00000000"
        android:id="@+id/addButtonFIFTY"
        app:layout_constraintStart_toEndOf="@+id/addButtonTWENTY" android:layout_marginStart="24dp"
        app:layout_constraintTop_toTopOf="parent" android:layout_marginTop="172dp"/>
    <ImageButton
        android:layout_width="@dimen/text_width"
        android:layout_height="@dimen/text_height" app:srcCompat="@mipmap/coin_i_foreground"
        android:background="#00000000"
        android:id="@+id/addButtonI"
        app:layout_constraintStart_toEndOf="@+id/addButtonFIFTY" android:layout_marginStart="24dp"
        app:layout_constraintTop_toTopOf="parent" android:layout_marginTop="172dp"/>
    <ImageButton
        android:layout_width="@dimen/text_width"
        android:layout_height="@dimen/text_height" app:srcCompat="@mipmap/coin_ii_foreground"
        android:background="#00000000"
        android:id="@+id/addButtonII"
        app:layout_constraintStart_toEndOf="@+id/addButtonI" android:layout_marginStart="24dp"
        app:layout_constraintTop_toTopOf="parent" android:layout_marginTop="172dp"/>
    <ImageButton
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" app:srcCompat="@android:drawable/btn_dialog"
        android:background="#00000000"
        android:id="@+id/closeCoinYearAdding"
        app:layout_constraintTop_toTopOf="parent" android:layout_marginTop="24dp" android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>