<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/block_small_icon"
        android:label="@string/app_name"
        android:roundIcon="@drawable/block_small_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.MuenzApp"
        tools:targetApi="31">
        <meta-data
            android:name="com.example.muenzapp"
            android:value="@integer/google_play_services_version" />
        <activity
            android:name=".LoginActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.NoActionBar"/>
        <activity
            android:name=".RegisterActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.NoActionBar"/>
        <activity
            android:name=".Authentication"
            android:screenOrientation="portrait"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.NoActionBar"/>

        <activity
            android:name=".StartingPageActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.NoActionBar" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".GermanCoins.GermanOverviewActivity"
            android:exported="false"
            android:parentActivityName=".StartingPageActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.NoActionBar" />
        <activity
            android:name=".GermanCoins.GermanAddingActivity"
            android:exported="false"
            android:parentActivityName=".GermanCoins.GermanOverviewActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.NoActionBar" />
        <activity
            android:name=".GermanCoins.GermanCoinTableActivity"
            android:exported="false"
            android:parentActivityName=".GermanCoins.GermanOverviewActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.NoActionBar" />
        <activity
            android:name=".InternCoins.InternCoinTableActivity"
            android:exported="false"
            android:parentActivityName=".StartingPageActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.NoActionBar" />
        <activity
            android:name=".InternCoins.InternAddingActivity"
            android:exported="false"
            android:parentActivityName=".InternCoins.InternCoinTableActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.NoActionBar" />
    </application>

</manifest>