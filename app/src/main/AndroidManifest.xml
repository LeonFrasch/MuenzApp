<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MuenzApp"
        tools:targetApi="31">
        <activity
            android:name=".StartingPageActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.AppCompat.NoActionBar" />
        <activity
            android:name=".GermanCoins.GermanOverviewActivity"
            android:exported="false"
            android:parentActivityName=".StartingPageActivity"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.AppCompat.NoActionBar" />
        <activity
            android:name=".GermanCoins.GermanAddingActivity"
            android:exported="false"
            android:parentActivityName=".GermanCoins.GermanOverviewActivity"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.AppCompat.NoActionBar" />
        <activity
            android:name=".GermanCoins.GermanCoinTableActivity"
            android:exported="false"
            android:parentActivityName=".GermanCoins.GermanOverviewActivity"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.AppCompat.NoActionBar" />
        <activity
            android:name=".InternCoins.InternCoinTableActivity"
            android:exported="false"
            android:parentActivityName=".StartingPageActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.NoActionBar" />
        <activity
            android:name=".InternCoins.InternAddingActivity"
            android:exported="false"
            android:parentActivityName=".InternCoins.InternCoinTableActivity"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.AppCompat.NoActionBar"/>
    </application>

</manifest>